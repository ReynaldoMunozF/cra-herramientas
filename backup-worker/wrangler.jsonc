{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "manual-cra-backup-diario",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["17 2 * * *"]
  },
  "d1_databases": [
    {
      "binding": "CONTENIDO_DB",
      "database_name": "manual-cra-contenido",
      "database_id": "17f6fd72-f222-42a9-b736-a8f6d7de92c6"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RESPALDOS",
      "id": "4b7b0ac427694bcc9936f54b296fc822"
    }
  ]
}
